<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local TTL reaper for genesis e2e/local-mode scratch repos.
  Runs `manual_e2e.py reap` hourly using the user's own gh credentials
  (no delete-scoped secret stored anywhere). Deletes only the hardcoded
  REAP_ALLOWLIST repos once they are older than the TTL (default 48h).

  Install (adjust the repo path below if genesis lives elsewhere):
    cp scripts/genesis-reap.plist ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist
    launchctl unload ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist 2>/dev/null
    launchctl load  -w ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist
    rm ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist
  Logs: /tmp/genesis-reap.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.sayfan.genesis-reap</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/gigi/git/genesis &amp;&amp; direnv exec . uv run python scripts/manual_e2e.py reap</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/genesis-reap.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/genesis-reap.log</string>
</dict>
</plist>
