<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local TTL reaper for genesis e2e/local-mode scratch repos.
  Runs `manual_e2e.py reap` hourly using the user's own gh credentials
  (no delete-scoped secret stored anywhere). Deletes only the hardcoded
  REAP_ALLOWLIST repos once they are older than the TTL (default 48h).

  This is a TEMPLATE: __GENESIS_DIR__ is substituted with the absolute path of
  your genesis clone at install time. Do not run this file directly.

  Install (macOS): from the genesis repo root, run
    uv run python scripts/manual_e2e.py install-reaper
  which renders this template with your repo path, writes it to
  ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist, and loads it.
  Remove:
    launchctl unload ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist
    rm ~/Library/LaunchAgents/ai.sayfan.genesis-reap.plist
  Logs: /tmp/genesis-reap.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.sayfan.genesis-reap</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd __GENESIS_DIR__ &amp;&amp; direnv exec . uv run python scripts/manual_e2e.py reap</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/genesis-reap.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/genesis-reap.log</string>
</dict>
</plist>
