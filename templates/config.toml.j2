[project]
name = "{{ project_name }}"
goal = "{{ goal }}"

# Loki activity logging is configured entirely through the environment
# (GENESIS_LOKI_URL / GENESIS_LOKI_USER / GENESIS_LOKI_TOKEN), not from this
# file — the token is a secret and this file is committed.

[issues]
# Backend: "github" or "linear"
backend = "github"

[a2h]
# A2H gateway endpoint
# Set via environment: GENESIS_A2H_GATEWAY_URL
gateway_url = ""
{% if target_repos %}

[targets]
repos = [
{%- for repo in target_repos %}
    "{{ repo }}",
{%- endfor %}
]
{% endif %}
